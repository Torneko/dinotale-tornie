# CI-only inclusion through CMAKE_PROJECT_DinoTale_INCLUDE; no ROM generator.
include_guard(GLOBAL)
function(dinotale_ci_preserved_rsp0355)
    if(EXISTS "${CMAKE_SOURCE_DIR}/yoshisstory.us.z64")
        message(FATAL_ERROR "ROM forbidden in ROM-free CI")
    endif()
    if(NOT EXISTS "${DT_CI_RSP_SOURCE}" OR NOT TARGET DinoTale)
        message(FATAL_ERROR "Verified preserved RSP source/target missing")
    endif()
    get_target_property(_sources DinoTale SOURCES)
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "aspMain[.]cpp$")
            message(FATAL_ERROR "Unexpected existing/generated native RSP source")
        endif()
    endforeach()
    target_sources(DinoTale PRIVATE "${DT_CI_RSP_SOURCE}")
    target_compile_definitions(DinoTale PRIVATE DT_HAS_RSP_AUDIO)
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL dinotale_ci_preserved_rsp0355)
