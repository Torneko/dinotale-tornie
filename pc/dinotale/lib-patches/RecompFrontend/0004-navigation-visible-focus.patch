+        static bool contains(Element *root, Element *target) {
+            if (root == target) return true;
+            for (auto child : root->nav_children) if (contains(child, target)) return true;
+            return false;
+        }
+
+        static Element *first_focusable(Element *root) {
+            const auto focus = root->is_focusable();
+            if (focus == Element::CanFocus::NoAndNoChildren) return nullptr;
+            if (focus == Element::CanFocus::Yes) return root;
+            for (auto child : root->nav_children) {
+                if (auto found = first_focusable(child)) return found;
+            }
+            return nullptr;
+        }
+
+        Element *recovery_target(Element *doc) {
+            auto preferred = get_current_context().get_autofocus_element();
+            if (preferred && preferred->is_focusable() == Element::CanFocus::Yes && contains(doc, preferred)) return preferred;
+            return first_focusable(doc);
+        }
