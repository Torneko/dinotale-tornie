--- /dev/null
+++ b/src/render/rt64_buffer_history.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <cassert>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace RT64 {
+    // Call only after GPU work referencing older inputs has completed.
+    // Pool capacity may exceed the used count: back() is not necessarily
+    // the latest input after a smaller workload reuses an existing pool.
+    template <typename Buffer>
+    void retainLatestBuffer(std::vector<Buffer> &history, uint32_t &count) {
+        assert(count <= history.size());
+        if (count > 1) {
+            std::swap(history.front(), history[count - 1]);
+            count = 1;
+        }
+    }
+}
