diff --git a/src/gbi/rt64_gbi_s2dex_slice.h b/src/gbi/rt64_gbi_s2dex_slice.h
new file mode 100644
--- /dev/null
+++ b/src/gbi/rt64_gbi_s2dex_slice.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+namespace RT64::GBI_S2DEX {
+    struct BackgroundSlice {
+        int32_t sourceRow, phase, screenRows, sourceRows;
+    };
+
+    // Caller guarantees at least one whole screen row fits with the bilinear
+    // guard row. Source coordinates and scale are in 1/1024 texel units.
+    inline BackgroundSlice backgroundSlice(int64_t sourceY, int32_t sourceHeight,
+        int32_t remainingScreenRows, int32_t availableSourceRows, int32_t scale) {
+        const int64_t period = int64_t(sourceHeight) << 10;
+        sourceY = (sourceY % period + period) % period;
+        const int32_t phase = int32_t(sourceY & 1023);
+        const int32_t rows = std::min(remainingScreenRows,
+            ((availableSourceRows << 10) - phase) / scale);
+        return { int32_t(sourceY >> 10), phase, rows,
+            (phase + rows * scale + 1023) >> 10 };
+    }
+}
