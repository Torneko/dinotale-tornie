# Compile the source prepared locally from the checked content image.
# The upstream original-ROM generator must stay disabled for this source flow.
include_guard(GLOBAL)
function(dinotale_use_prepared_rsp0355)
    if(EXISTS "${CMAKE_SOURCE_DIR}/yoshisstory.us.z64")
        message(FATAL_ERROR "The prepared-source build requires no original ROM at the source root")
    endif()
    if(NOT TARGET DinoTale OR NOT EXISTS "${DINO_PREPARED_RSP_SOURCE}")
        message(FATAL_ERROR "DinoTale target or verified prepared RSP source is missing")
    endif()
    get_target_property(_sources DinoTale SOURCES)
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "aspMain[.]cpp$")
            message(FATAL_ERROR "An RSP source was already added; refusing duplicate or automatic generation")
        endif()
    endforeach()
    target_sources(DinoTale PRIVATE "${DINO_PREPARED_RSP_SOURCE}")
    target_compile_definitions(DinoTale PRIVATE DT_HAS_RSP_AUDIO)
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL dinotale_use_prepared_rsp0355)
